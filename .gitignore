node_modules/
dist/
coverage/
*.log
.DS_Store
.env
.env.*

# Server runtime state
data/

# Local working notes, never tracked
HANDOFF.md
PLAN.md
*.local.md

# Playwright MCP artifacts
.playwright-mcp/

# Tauri build output
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/
# Written by apps/desktop/scripts/instance-config.mjs from ENGRAM_APP_URL, so
# a build never leaves the builder's own address in a tracked file.
apps/desktop/src-tauri/tauri.instance.json
apps/desktop/src-tauri/capabilities/instance.json

# Local code index
.intentdb/

# Vendored OnlyOffice editor assets (derived; rebuild with scripts/office-assets.mjs)
apps/web/public/office/
.office-cache/

# Auto-generated code map from the local index
docs/codemap/
