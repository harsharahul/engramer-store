{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Engram Store",
  "version": "0.37.0",
  "identifier": "com.harsharahul.engramstore",
  "build": {
    "frontendDist": "http://localhost:3080",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Engram Store",
        "url": "http://localhost:3080",
        "width": 1280,
        "height": 820,
        "minWidth": 390,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
