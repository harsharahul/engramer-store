{
  "identifier": "main",
  "description": "The main window, serving the hosted vault app: it may call the shell's unlock commands.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://localhost:3080",
      "http://localhost:5173"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "shell-commands",
    "notification:default"
  ]
}
