# Copy to .env and fill in what your deployment uses.
# compose.yml needs none of this; compose.rclone.yml needs the gateway pair
# plus the token for your provider's profile.

# Internal credentials between the app and the rclone sidecar. Generate once:
#   echo "ENGRAM_GATEWAY_KEY=$(openssl rand -hex 16)" >> .env
#   echo "ENGRAM_GATEWAY_SECRET=$(openssl rand -hex 32)" >> .env
ENGRAM_GATEWAY_KEY=
ENGRAM_GATEWAY_SECRET=

# Drime (--profile drime): create a token under Settings, Developer.
DRIME_TOKEN=

# pCloud (--profile pcloud): run `rclone authorize pcloud` on any desktop
# and paste the JSON it prints, including the braces.
PCLOUD_TOKEN=

# Per-user storage quota in bytes (default 100 GB).
#ENGRAMER_QUOTA_BYTES=107374182400
